{
  "name": "Bill Splitter",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false
      }
    }
  },
  "postCreateCommand": "python --version && echo 'Python environment ready!'",
  "remoteUser": "vscode"
}
